{
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "www.agenciamasclicks.com" }], "status": 308, "headers": { "Location": "https://agenciamasclicks.com/$1" } },
    { "src": "/", "has": [{ "type": "host", "value": "webs.agenciamasclicks.com" }], "dest": "/web.html" },
    { "src": "/", "has": [{ "type": "host", "value": "contenido.agenciamasclicks.com" }], "dest": "/contenido.html" }
  ]
}
